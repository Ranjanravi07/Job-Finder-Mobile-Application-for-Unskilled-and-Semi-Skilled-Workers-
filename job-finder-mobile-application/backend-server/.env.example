# ==========================================
# Server
# ==========================================

PORT=3000


# ==========================================
# Twilio
# ==========================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=


# ==========================================
# Firebase Admin
# ==========================================
# Option 1:
# Keep serviceAccountKey.json in the backend folder.
# In that case, you can leave this commented.

# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}


# ==========================================
# Environment
# ==========================================

NODE_ENV=development
