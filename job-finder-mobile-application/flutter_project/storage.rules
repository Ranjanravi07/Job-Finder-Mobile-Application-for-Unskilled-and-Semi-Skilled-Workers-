rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      // Storage rules cannot easily read Firestore directly without Cloud Functions or Custom Claims.
      // Assuming Custom Auth Claims are set for admins: request.auth.token.role == 'admin'.
      // If not using Custom Claims, you may need a separate mechanism.
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // Profile Images
    match /profile_images/workers/{userId}/{allPaths=**} {
      allow read: if true; // Profile images can be public
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /profile_images/employers/{userId}/{allPaths=**} {
      allow read: if true; // Profile images can be public
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Government IDs (Private)
    match /government_ids/workers/{userId}/{allPaths=**} {
      // Only the user themselves or an admin can read the ID files
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only the user can upload their own ID files
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /government_ids/employers/{userId}/{allPaths=**} {
      // Only the user themselves or an admin can read the ID files
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Only the user can upload their own ID files
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
